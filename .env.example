# Firebase Web SDK (public runtime configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sircah.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sircah
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sircah.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=464978772261
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps / Geocoding (use a browser-restricted key)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase Admin credentials stay private and must never use NEXT_PUBLIC_*.
# Configure these three variables in Vercel Environment Variables.
FIREBASE_PROJECT_ID=sircah
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"